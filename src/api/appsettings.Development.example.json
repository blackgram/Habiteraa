{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=habitera;Username=habitera;Password=habitera",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "local-dev-only-change-me-to-a-long-random-string-at-least-32-chars",
    "Issuer": "Habitera",
    "Audience": "Habitera",
    "ExpirationMinutes": "1440",
    "RefreshTokenExpiryDays": "30"
  },
  "Verification": {
    "EmailCodeExpiryMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "PasswordResetCodeExpiryMinutes": 15
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5141"
  },
  "ListingModeration": {
    "AutoApproveAfterMinutes": 30,
    "AutoApproveCron": "*/5 * * * *"
  },
  "Cloudinary": {
    "CloudName": "local-dev",
    "ApiKey": "local-dev-key",
    "ApiSecret": "local-dev-secret"
  },
  "SendGrid": {
    "ApiKey": "your-sendgrid-api-key",
    "FromEmail": "noreply@habitera.local",
    "FromName": "Habitera"
  },
  "Brevo": {
    "SmtpServer": "smtp-relay.brevo.com",
    "Port": "587",
    "FromEmail": "noreply@habitera.local",
    "FromName": "Habitera",
    "Username": "your-brevo-username",
    "Password": "your-brevo-password"
  },
  "MockUsers": {
    "User": {
      "Email": "user@habitera.local",
      "Password": "Password1!"
    },
    "Agent": {
      "Email": "agent@habitera.local",
      "Password": "Password1!"
    }
  }
}
